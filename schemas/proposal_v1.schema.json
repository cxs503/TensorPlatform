{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "proposal_v1.schema.json",
  "title": "Proposal Schema v1 (Legacy)",
  "description": "历史口径提案格式，需经兼容层映射到 v2 内部模型",
  "type": "object",
  "required": ["title", "repo", "description"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "提案标题"
    },
    "repo": {
      "type": "string",
      "description": "目标仓库名"
    },
    "description": {
      "type": "string",
      "description": "提案描述"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "metric": {"type": "string"},
          "threshold": {"type": "number"}
        }
      },
      "description": "验收目标列表（v1 允许无阈值）"
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "依赖列表"
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium"
    },
    "metadata": {
      "type": "object",
      "description": "扩展元数据"
    }
  },
  "additionalProperties": false
}
