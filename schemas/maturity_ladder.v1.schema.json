{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform.local/schemas/maturity_ladder.v1.schema.json",
  "title": "Capability maturity five-level ladder declaration",
  "description": "Machine-adjudicable evidence chain for the five-level capability maturity ladder: Implemented → Tested → Benchmark-verified → Coupled prototype → Engineering-qualified. Every transition records timestamp, evidence, adjudicator and rollback point.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ladder", "capabilities", "transitions"],
  "properties": {
    "schema_version": {"const": "maturity-ladder/1.0"},
    "ladder": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"type": "string"},
      "const": ["Implemented", "Tested", "Benchmark-verified", "Coupled prototype", "Engineering-qualified"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "current_level", "history"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "current_level": {"enum": ["Implemented", "Tested", "Benchmark-verified", "Coupled prototype", "Engineering-qualified"]},
          "level_rank": {"type": "integer", "minimum": 0, "maximum": 4},
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["transition_id", "capability_id", "from_level", "to_level", "timestamp", "evidence_refs", "adjudicator", "rollback_point", "reason"],
              "properties": {
                "transition_id": {"type": "string", "minLength": 1},
                "capability_id": {"type": "string", "minLength": 1},
                "from_level": {"enum": ["Implemented", "Tested", "Benchmark-verified", "Coupled prototype", "Engineering-qualified"]},
                "to_level": {"enum": ["Implemented", "Tested", "Benchmark-verified", "Coupled prototype", "Engineering-qualified"]},
                "timestamp": {"type": "string"},
                "evidence_refs": {"type": "array", "items": {"type": "string"}},
                "adjudicator": {"type": "string", "minLength": 1},
                "rollback_point": {
                  "oneOf": [
                    {"type": "null"},
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["capability_id", "level_before", "evidence_digest", "created_at"],
                      "properties": {
                        "capability_id": {"type": "string", "minLength": 1},
                        "level_before": {"enum": ["Implemented", "Tested", "Benchmark-verified", "Coupled prototype", "Engineering-qualified"]},
                        "evidence_digest": {"type": "string"},
                        "created_at": {"type": "string"}
                      }
                    }
                  ]
                },
                "reason": {"type": "string"},
                "direction": {"enum": ["up", "down", "rollback"]}
              }
            }
          },
          "metadata": {"type": "object"},
          "updated_at": {"type": "string"}
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transition_id", "capability_id", "from_level", "to_level", "timestamp", "evidence_refs", "adjudicator", "rollback_point", "reason"],
        "properties": {
          "transition_id": {"type": "string", "minLength": 1},
          "capability_id": {"type": "string", "minLength": 1},
          "from_level": {"enum": ["Implemented", "Tested", "Benchmark-verified", "Coupled prototype", "Engineering-qualified"]},
          "to_level": {"enum": ["Implemented", "Tested", "Benchmark-verified", "Coupled prototype", "Engineering-qualified"]},
          "timestamp": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "adjudicator": {"type": "string", "minLength": 1},
          "rollback_point": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["capability_id", "level_before", "evidence_digest", "created_at"],
                "properties": {
                  "capability_id": {"type": "string", "minLength": 1},
                  "level_before": {"enum": ["Implemented", "Tested", "Benchmark-verified", "Coupled prototype", "Engineering-qualified"]},
                  "evidence_digest": {"type": "string"},
                  "created_at": {"type": "string"}
                }
              }
            ]
          },
          "reason": {"type": "string"},
          "direction": {"enum": ["up", "down", "rollback"]}
        }
      }
    }
  }
}
