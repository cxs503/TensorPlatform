{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/kf_result.v1.schema.json",
  "title": "Knowledge Factory work-package result envelope v1",
  "description": "平台侧结果信封：任何工序（01-05）的产出都包一层同样的信封，结构门才有统一验收面。工序 03 建议同时按 TensorKnowledge 的 claims/evidence/provenance 字段名组织，SPEC 到位后由外部 schema 叠加校验，本文件不改。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_id",
    "task_type",
    "report_id",
    "provenance",
    "outputs"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "pattern": "^wp-[A-Za-z0-9][A-Za-z0-9_.:-]*-[0-9]{2}$"
    },
    "task_type": {
      "type": "string",
      "pattern": "^[0-9]{2}(-[a-z0-9-]+)?$",
      "description": "工序短码（01-05）或契约全名（如 03-knowledge-extraction），二者等价。"
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source_hash",
        "source_field"
      ],
      "properties": {
        "source_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_field": {
          "enum": [
            "markdown",
            "summary",
            "record"
          ]
        },
        "producer": {
          "type": "string"
        },
        "emitted_at": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "description": "键名=工序声明的输出文件名（见 contracts），值=该文件内容对象。",
      "additionalProperties": {
        "type": [
          "object",
          "array",
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "claims": {
      "type": "array",
      "description": "工序 03 的知识对象候选；零条=合法完整结果（不得为填指标而造知识）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "partially-supported",
              "unresolved",
              "refuted"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quote"
              ],
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "source_field": {
                  "enum": [
                    "markdown",
                    "summary",
                    "record"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "unresolved_reason": {
            "type": "string"
          }
        }
      }
    }
  }
}