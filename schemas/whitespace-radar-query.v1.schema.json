{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform/schemas/whitespace-radar-query.v1.schema.json",
  "title": "whitespace radar query (radar-query/v1)",
  "description": "Input contract for batch queries, used by the arbitration de-dup gate before a proposal is admitted. Unknown major versions must be rejected.",
  "type": "object",
  "required": ["schema", "topics"],
  "additionalProperties": true,
  "properties": {
    "schema": {"const": "radar-query/v1"},
    "pool": {"type": "string", "description": "optional pool manifest path override"},
    "source": {"type": "string", "description": "who asks (gate/proposer/agent id), recorded for audit"},
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic"],
        "properties": {
          "id": {"type": "string"},
          "topic": {"type": "string", "minLength": 1},
          "label": {"enum": ["covered", "partial", "blank"], "description": "optional expectation, scored when present"}
        }
      }
    }
  }
}