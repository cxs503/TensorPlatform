{
  "schema_version": "invariant-audit/1.0",
  "plan_id": "synthetic-solver-matrix",
  "description": "Injected declarations for the cross-solver invariant audit. Every target is a synthetic arithmetic model (tools/invariant_audit/anchors); the mechanism never sees anything but callables, parameters and tolerances. Known-good targets must PASS, planted defects must FAIL, targets that do not report the required observable must be WITHHELD.",
  "base_dimensions": [
    "length",
    "mass",
    "time"
  ],
  "targets": [
    {
      "id": "synth-grid-flux-form",
      "label": "conservative flux-form grid update",
      "callable": "tools.invariant_audit.anchors.synthetic_models:transport_grid",
      "config": {
        "cells": 200,
        "length": 1.0,
        "velocity": 0.2,
        "dt": 0.01,
        "steps": 50,
        "pulse_center": 0.3,
        "pulse_width": 0.05,
        "scheme": "flux",
        "emit_flux": true,
        "trace": true,
        "velocity_modulation": 0.5,
        "stretch": 0.0
      },
      "invariants": [
        {
          "id": "mass-conservation",
          "kind": "conservation",
          "params": {
            "quantity": "mass",
            "initial": "mass_initial",
            "final": "mass_final",
            "flux": "boundary_flux"
          },
          "tolerance": {
            "rtol": 1e-12,
            "atol": 0.0
          }
        },
        {
          "id": "boost-covariance",
          "kind": "covariance",
          "params": {
            "input_key": "velocity",
            "observable": "displacement",
            "input_transform": {
              "offset": [
                0.05
              ]
            },
            "output_transform": {
              "offset": [
                0.025
              ]
            }
          },
          "tolerance": {
            "rtol": 1e-09,
            "atol": 1e-12
          },
          "note": "velocity boosted by 0.05 over a horizon of 0.5 time units"
        }
      ]
    },
    {
