        }
      ]
    },
    "dev.restart": {
      "manual_grade": "WITHHELD",
      "probes": [
        {
          "id": "DEV-RESTART-EXIST-01",
          "type": "EXISTENCE",
          "endpoint": "dev/restart",
          "method": "POST",
          "input_base": {},
          "check_expr": "status == 200",
          "tolerance": 200.0,
