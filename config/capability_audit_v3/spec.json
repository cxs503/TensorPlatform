        }
      ]
    },
    "dev.services": {
      "manual_grade": "WITHHELD",
      "probes": [
        {
          "id": "DEV-SERVICES-EXIST-01",
          "type": "EXISTENCE",
          "endpoint": "dev/services",
          "method": "GET",
          "input_base": {},
          "check_expr": "status == 200",
          "tolerance": 200.0,
          "description": "端点可达性"
        }
      ]
    }
  }
}
