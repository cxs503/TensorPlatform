{
  "schema_version": "1.0",
  "purpose": "12-repo tenant registry for the platform-wide isolation mechanism. Tenant identity, repo binding, allowed domain tokens, data classification and per-cycle resource quota are DATA injected here, never hardcoded into backend/tools/tests (zero domain semantics rule).",
  "policy": {
    "default_decision": "deny",
    "shared_read_roots": ["shared", "platform_shared"],
    "artifact_root": "artifacts/tenants",
    "report_root": "tensor_reports/tenants",
    "event_root": "events/tenants"
  },
  "resource_keys": ["cpu_core_hours", "memory_gb_hours", "storage_gb", "concurrent_tasks", "periodic_tasks"],
  "data_classifications": ["public", "internal", "restricted"],
  "tenants": [
    {
      "name": "tenant-lbm",
      "repo": "TensorLBM",
      "allowed_domains": ["dom-a1"],
