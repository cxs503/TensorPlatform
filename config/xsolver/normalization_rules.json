  "quantity_limits": {
    "max_per_case": 60,
    "note": "bounds the corpus size; selection is deterministic (sorted by container then leaf)"
  },
  "selection_note": "primary_quantities default to OUTPUT unless the leaf sits under a declared input container or matches an excluded run-parameter token; that inversion is what makes the normaliser work on 100 heterogeneous artifacts without a per-artifact adapter",
  "geometry_hint_container_keys": [
    "params",
    "parameters",
    "settings",
    "config",
    "configuration",
    "case_config",
    "primary_config",
    "setup",
    "mesh",
    "geometry_inputs"
  ],
  "dimension_match": {
    "mode": "exact, then affix match on '_' boundaries for aliases of length >= 4",
    "note": "affix matching is what lets 'domain_length' / 'length_a' / 'contact_radius' resolve without listing every compound key; single-letter aliases stay exact-only because 'L'/'T'/'D' are hopelessly ambiguous"
  }
}