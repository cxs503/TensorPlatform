    "mass": {
      "relative": [
        "mass_drift_pct",
        "mass_drift_rel",
        "mass_residual",
        "mass_error_rel",
        "mass_conservation_error"
      ],
      "absolute": [
        "mass_drift",
        "mass_delta",
        "delta_mass"
      ],
      "percent_scale": [
        "mass_drift_pct"
      ]
    },
    "momentum": {
      "relative": [
        "momentum_drift_pct",
        "momentum_residual",
        "momentum_error_rel",
        "momentum_conservation_error"
      ],
      "absolute": [
        "momentum_drift",
        "delta_momentum"
      ],
      "percent_scale": [
        "momentum_drift_pct"
      ],
      "fallback": {
        "from": [
          "last_resid",
          "resid",
          "iterative_residual",
          "resid_u",
          "last_residual"
        ],
        "note": "no global momentum residual is recorded by most artifacts; the steady-state velocity-update residual is used as the momentum-balance proxy and reported as such"
      }
    },
    "energy": {
      "relative": [
        "energy_drift_pct",
        "energy_residual",
        "energy_error_rel"
      ],
      "absolute": [
        "energy_drift",
        "delta_energy"
      ],
      "percent_scale": [
        "energy_drift_pct"
      ]
    }
  },
