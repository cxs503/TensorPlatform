      "field_aliases": {
        "temperature": {"FVM": "T", "BEM": "T"},
        "heat_flux": {"FVM": "face_flux", "BEM": "neumann_data"}
      }
    },
    {
      "pair": ["FEM", "BEM"],
      "application": "thermal_conduction_1d",
      "state_fields": [{"name": "temperature", "units": "K", "aliases": ["T", "u"]}],
