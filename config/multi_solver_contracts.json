      "application": "thermal_conduction_1d",
      "state_fields": [{"name": "temperature", "units": "K", "aliases": ["T", "u"]}],
      "flux_fields": [{"name": "heat_flux", "units": "W/m", "aliases": ["q", "flux"]}],
      "field_aliases": {
        "temperature": {"FVM": "T", "FEM": "T"},
        "heat_flux": {"FVM": "face_flux", "FEM": "boundary_flux"}
      }
    },
    {
      "pair": ["FVM", "BEM"],
      "application": "thermal_conduction_1d",
