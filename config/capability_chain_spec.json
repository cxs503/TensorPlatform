  "review_pass_values": [
    "PASS",
    "APPROVED",
    "ACCEPTED"
  ],
  "artifact_filename": "artifact.json",
  "report_filename": "report.json",
  "metrics_filename": "metrics.json",
  "review_filename": "review.json",
  "pytest_xml_filename": "pytest.xml",
  "pytest_json_filename": "pytest.json",
  "default_level": "WITHHELD"
}
