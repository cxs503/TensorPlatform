      "label": "阻力计算",
      "description": "船舶阻力计算能力，包含经验公式与数值方法",
      "expected_evidence_types": ["theory", "code", "config", "data", "report"],
      "code_patterns": ["resistance", "holtrop", "ITTC", "Cf", "Rt"],
      "test_patterns": ["test_resistance", "test_holtrop", "test_itc"],
      "report_patterns": ["resistance"],
      "initial_level": "WITHHELD"
    },
    {
      "capability_id": "calc.stability",
