{
  "schema_version": "1.0",
  "title": "能力台账语义三元分层配置（capability / delivery / evidence）",
  "zero_domain_semantics": "本仓代码（tools/capability_semantics、backend/api/capability_semantics.py）不含任何域词条；能力 id / 标签 / 学科 / 依赖边 / 交付扫描根目录全部经此文件注入。",
  "level_rank": {
    "NOT_SUPPORTED": 0,
    "STUB": 1,
    "MOCK": 2,
    "WITHHELD": 3,
    "REAL": 4
  },
  "thresholds": {
    "numeric_pass_pct": 3.0,
    "numeric_accept_pct": 15.0,
    "entry_loss_max_ratio": 0.05,
    "withheld_ratio_max": 0.3,
    "orphan_ratio_max": 0.05,
    "min_graded_entries": 20,
    "min_misuse_fixes": 3,
    "min_numeric_assert_tests_mock": 1
  },
  "delivery_discovery": {
    "endpoint_roots": [
      "backend/api/domain"
    ],
    "scan_subdirs": [
      "backend",
      "src",
      "tests",
      "docs"
    ],
    "endpoint_decorator_regex": "@(?:router|app)\\.(?:get|post|put|patch|delete)\\(",
    "unbound_module_allowlist": [
      "backend/api/domain/__init__.py"
    ],
    "exclude_glob_patterns": [
      "artifacts/capability_semantics/**",
      "docs/reports/P266W1_N10_*",
      "docs/reports/capability_semantics/**",
      "tools/capability_semantics/**"
    ],
    "exclude_rationale": "自指证据治理：本节点的产物（报告/工件/模块自身）若被扫描器当成验证工件，会把『报告里写了数字』变成『有能力证据』的循环论证，必须排除。"
  },
