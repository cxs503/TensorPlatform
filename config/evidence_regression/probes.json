              "beam": 20.0,
              "draft": 8.0,
              "cb": 0.7,
              "speed": 5.0
            }
          }
        ],
        "field": "reynolds"
      },
      "probes": [
        {
          "kind": "anchor",
          "field": "reynolds",
          "label": "analytic identity Re = V*L/nu",
          "cases": [
            {
              "kwargs": {
                "length": 100.0,
                "beam": 20.0,
                "draft": 8.0,
                "cb": 0.7,
                "speed": 5.0
