          "values": [
            3.0,
            5.0,
            7.0,
            9.0
          ],
          "direction": "increasing",
          "tol_rel": 1e-09
        },
        {
          "kind": "nontriviality",
          "field": "rt_n",
          "cases": [
            {
              "kwargs": {
                "length": 100.0,
                "beam": 20.0,
                "draft": 8.0,
                "cb": 0.7,
                "speed": 3.0
