{
  "schema_version": "evidence_probe_registry.v1",
  "title": "能力证据等级探针注册表（REAL→MOCK 静默降级红灯化）",
  "description": "每个能力条目把一条真实实现调用链（target）与一组通用契约探针（anchor/scale_law/monotonic/nontriviality/determinism/bounded）绑定。全部输入、期望值、容差都是数据；机制层（tools/evidence_regression）零领域语义。anchor 的 label 标注取值来源：analytic identity=从闭式关系独立推出；formula pin=按公开公式实现的口径钉；published pin=公开几何/字典数据；golden pin=冻结基线观测量（只能检出形状类退化，不能检出同量级物理漂移）。",
  "levels_source": {
    "path": "artifacts/capability_ledger/capability_ledger_resolved.json",
    "field": "claimed_level",
    "note": "等级来源台账：门判定只读该字段，不猜。"
  },
  "entries": [
    {
      "capability_id": "calc.resistance",
