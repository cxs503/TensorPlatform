            "id": "g_mass_balance_error_m3",
            "path": "acceptance.g_mass_balance_error_m3",
            "op": "<=",
            "threshold": 1e-09
          },
          {
            "id": "h_negative_gm_eff_m",
            "path": "acceptance.h_negative_gm_eff_m",
            "op": "<=",
            "threshold": 0.0,
            "note": "负例：进水致 GM_eff<0 必须被检出"
          },
          {
            "id": "h_negative_capsize_time_s",
            "path": "acceptance.h_negative_capsize_time_s",
            "op": ">=",
            "threshold": 0.1,
            "note": "负例：失稳时刻必须有限且可检出"
          },
          {
            "id": "diff_f_A_minus_R",
            "paths": [
              "acceptance.f_A",
              "acceptance.f_R"
            ],
            "combine": "subtract",
            "op": ">=",
            "threshold": 0.0,
            "note": "SOLAS 通过算例：A - R >= 0"
          },
          {
            "id": "diff_f_fail_A_minus_R",
            "paths": [
              "acceptance.f_fail_case_A",
              "acceptance.f_fail_case_R"
            ],
            "combine": "subtract",
            "op": "<=",
            "threshold": 0.0,
            "role": "case_verdict",
            "note": "负例算例：A - R <= 0（闸门不得误判为通过）"
          }
        ],
        "capabilities": [
          {
            "id": "damage_stability.compartment_geometry",
