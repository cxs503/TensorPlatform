          {
            "id": "b_orifice_max_rel_error",
            "path": "acceptance.b_orifice_max_rel_error",
            "op": "<=",
            "threshold": 0.01
          },
          {
            "id": "c_constant_head_rel_error",
            "path": "acceptance.c_constant_head_rel_error",
            "op": "<=",
            "threshold": 0.02
          },
          {
            "id": "c_falling_head_rel_error",
            "path": "acceptance.c_falling_head_rel_error",
            "op": "<=",
            "threshold": 0.02
          },
          {
            "id": "d_gz_max_rel_error_pct",
            "path": "acceptance.d_gz_max_rel_error_pct",
