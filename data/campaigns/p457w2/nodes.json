          {
            "id": "damage_stability.solas_index_A_R",
            "claim_level": "REAL",
            "blocking_criteria": [
              "diff_f_A_minus_R",
              "diff_f_fail_A_minus_R"
            ],
            "summary": "SOLAS 分舱指数 A=sum(p_i s_i) 对 R 的闸门（含失败算例负例）"
          },
          {
            "id": "damage_stability.mass_conservation",
            "claim_level": "REAL",
            "blocking_criteria": [
              "g_mass_balance_error_m3"
            ],
            "summary": "进水过程体积账本守恒"
