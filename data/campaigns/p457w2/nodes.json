          {
            "id": "e_gm_eff_abs_error_m",
            "path": "acceptance.e_gm_eff_abs_error_m",
            "op": "<=",
            "threshold": 1e-09
          },
          {
            "id": "g_max_level_change_pct",
            "path": "acceptance.g_max_level_change_pct",
            "op": "<=",
            "threshold": 1.0,
