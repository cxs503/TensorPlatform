    {
      "tool_id": "version_control",
      "category": "vcs",
      "adapter": "version_control",
      "probe": {
        "kind": "executable",
        "name": "git"
      },
      "invariants": [
        {
          "metric": "head_sha_len",
          "limit": 0.0,
          "op": "abs",
          "target": 40.0,
          "ref": 40.0,
          "ref_source": "git object-id width for sha1 repositories"
        },
        {
          "metric": "commit_count",
          "limit": 1.0,
          "op": "ge"
        },
        {
          "metric": "blob_id_reproduced",
          "limit": 1.0,
          "op": "ge",
          "ref": 1.0,
          "ref_source": "re-derived sha1('blob <n>' + worktree bytes) must equal git rev-parse HEAD:<path>"
        },
        {
          "metric": "blob_catfile_roundtrip",
          "limit": 1.0,
          "op": "ge",
          "ref": 1.0,
          "ref_source": "git cat-file -p <oid> must return the exact worktree bytes (object store integrity)"
        }
      ],
      "notes": "HEAD identity is re-derivable, and so is a blob id from the bytes on disk: a git that runs but cannot reproduce an object id is not usable"
    },
