        },
        {
          "metric": "simpson_vs_pi_abs_err",
          "limit": 1e-06,
          "op": "le",
          "ref": 0.0,
          "ref_source": "closed form ∫0^1 4/(1+t²)dt = π (independent Simpson rule)"
        },
        {
          "metric": "quad_value",
          "limit": 1e-10,
          "op": "abs",
          "target": 3.141592653589793,
          "ref": 3.141592653589793,
          "ref_source": "math.pi (closed form; benchmark ref-vs-got)"
        }
      ],
      "notes": "closed form ∫0^1 4/(1+t²)dt = π is the reference; two independent rules"
    },
    {
      "tool_id": "blackbox_optimization",
