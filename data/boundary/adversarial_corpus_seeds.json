  "templates": {
    "note": "变异模板。槽位：{TERM}=词表内阻断词条，{PARA}=同义改写，{FOREIGN}=外文/转写，{CJK}=中文阻断词条，{ID}=中性 id，{W}=中性词，{N}=中性数值池，{ENC}=百分号编码，{ZW}=零宽插入，{HOMO}=同形字替换，{LEET}=数字替换，{PATH_D}=域承载工件路径，{PATH_T}=零词条工件路径，{ANCHOR}=节号，{DIMS}=主尺度三元组，{POWER}=功率数值，{CB}=方形系数，{RETAU}=Re_tau 数值。",
    "synonym_rewrite": {
      "pos_light": [
        "# {PARA} pipeline; evidence id \"{TERM}-{ID}\" kept for the regression baseline",
        "# {PARA} branch — regression id {TERM}-{ID} retained",
        "NOTE = \"{PARA} review (id: {TERM}-{ID})\"",
        "# {PARA} registry entry {TERM}-{ID} is quoted verbatim"
      ],
      "pos_heavy": [
        "def build_{ID}_context():  # {PARA} branch of the pipeline",
        "notes = \"stage-2 {PARA} review\"",
        "TABLE = \"{PARA} vs throughput\"",
        "def {ID}_profile():  # {PARA} assumptions live in the domain repo"
      ],
      "neg": [
        "def build_{ID}_context():  # {W} branch of the pipeline",
        "notes = \"stage-2 {W} review\"",
        "TABLE = \"{W} vs throughput\"",
        "# {W} registry entry {ID} is quoted verbatim"
      ]
    },
    "symbol_notation": {
      "pos_light": [
        "# {TERM}: cb = {CB}, L/B = 6.25, Re_tau = {RETAU}",
        "assert {N} is not None  # {TERM} case: cb={CB}"
      ],
      "pos_heavy": [
        "PRINCIPAL = {{\"length\": {DIMS0}, \"beam\": {DIMS1}, \"draft\": {DIMS2}, \"cb\": {CB}, \"displacement\": {DISP}}}",
        "INSTALLED = {POWER}  # MW",
        "TRIPLET = \"L {DIMS0} / B {DIMS1} / T {DIMS2}\"",
        "RE_TAU = {RETAU}  # transition criterion of the closure",
        "def profile_{ID}(cb={CB}, beam={DIMS1}):  # geometry envelope"
      ],
      "neg": [
        "PRINCIPAL = {{\"timeout_s\": 30, \"retries\": 3, \"alpha\": {CB}}}",
        "INSTALLED = {POWER}  # MW datacenter envelope for the compute pool",
        "TRIPLET = \"{N} / {N} / {N}\"",
        "re_tau = 180.0  # solver damping coefficient"
      ]
    },
    "cross_language": {
      "pos_light": [
        "# {CJK} 工况与 latin 混写：{ID}",
        "label = \"{CJK} 记录 / {W}\"",
