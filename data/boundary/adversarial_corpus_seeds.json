        "label = \"{NEUTRAL} 记录 / {W}\"",
        "NOTES = \"{NEUTRAL} assumptions\""
      ]
    },
    "block_embedding": {
      "pos_light": [
        "    | {TERM} | {CB} | unitless |",
        "    ```yaml\n    key: {TERM}\n    ```",
        "\"\"\"{ID} module.\n\n    {TERM} evidence rows: see below.\n    \"\"\""
      ],
      "pos_heavy": [
        "    | {DIMS0} | {DIMS1} | {DIMS2} | principal |",
