{
  "version": "tp.secret_scan.policy/v1",
  "note": "All detection knowledge is data, not code: patterns / entropy thresholds / whitelist classes / decoder settings / exit behaviour / history roots are injected here. Code contains no secret literals and no domain vocabulary. Synthetic calibration secrets are generated at runtime from a seed (never stored).",
  "detectors": {
    "patterns": {
      "enabled": true,
      "rules": [
        {
          "id": "pem_private_key",
          "regex": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----"
        },
        {
          "id": "pem_private_key_body",
          "regex": "(?P<value>(?<![A-Za-z0-9+/=])[A-Za-z0-9+/]{40,4000}={0,2})",
          "context_before": "PRIVATE KEY-----"
        },
        {
          "id": "jwt",
          "regex": "\\beyJ[A-Za-z0-9_-]{6,}\\.[A-Za-z0-9_-]{6,}\\.[A-Za-z0-9_-]{6,}\\b"
        },
        {
          "id": "db_url_credentials",
          "regex": "(?P<prefix>\\b[a-z][a-z0-9+.\\-]{0,20}://[^\\s:/@]{1,64}:)(?P<value>[^\\s@/'\"]{6,128})(?P<suffix>@)"
        },
        {
          "id": "aws_access_key_id",
          "regex": "\\b(?:AKIA|ASIA|AGPA|AIDA)[0-9A-Z]{16}\\b"
        },
        {
          "id": "aws_secret_access_key",
          "regex": "(?i)aws_?secret_?access_?key\\W{0,8}(?P<value>(?!<REDACTED)[A-Za-z0-9/+=]{40})"
        },
        {
          "id": "gcp_api_key",
          "regex": "\\bAIza[0-9A-Za-z_\\-]{35}\\b"
        },
        {
          "id": "azure_account_key",
          "regex": "(?i)account_?key\\W{0,8}(?P<value>(?!<REDACTED)[A-Za-z0-9+/]{86}==)"
        },
        {
          "id": "openai_key",
          "regex": "\\bsk-[A-Za-z0-9_\\-]{24,}\\b"
        },
        {
          "id": "github_token",
          "regex": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\\b|\\bgithub_pat_[A-Za-z0-9_]{20,}\\b"
        },
        {
          "id": "slack_token",
          "regex": "\\bxox[baprs]-[A-Za-z0-9\\-]{10,}\\b"
        },
        {
          "id": "stripe_live_key",
          "regex": "\\b[sr]k_live_[A-Za-z0-9]{16,}\\b"
        },
        {
          "id": "sendgrid_key",
          "regex": "\\bSG\\.[A-Za-z0-9_\\-]{16,}\\.[A-Za-z0-9_\\-]{16,}\\b"
        },
        {
          "id": "bearer_header",
          "regex": "(?i)(?P<prefix>\\bBearer\\s+)(?P<value>(?!<REDACTED)[A-Za-z0-9._~+/=\\-]{16,})"
        },
        {
          "id": "basic_auth_header",
          "regex": "(?i)(?P<prefix>\\bBasic\\s+)(?P<value>(?!<REDACTED)[A-Za-z0-9+/=]{16,})"
        },
        {
          "id": "env_assignment_secret",
          "regex": "(?i)(?P<prefix>\\b[A-Za-z0-9_]{0,40}(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL)[A-Za-z0-9_]{0,20}\\s{0,4}=\\s{0,4})(?P<value>(?!<REDACTED)[A-Za-z0-9+/=_\\-]{16,160})",
          "needs_entropy": true
        },
        {
          "id": "password_kv",
          "regex": "(?i)(?P<prefix>\\b[A-Za-z0-9_]{0,24}(?:password|passwd|pwd|secret|api_?key|access_?token|auth_?token|client_?secret)[A-Za-z0-9_]{0,24}[\"']?\\s{0,4}[:=]\\s{0,4}[\"'])(?P<value>(?!<REDACTED)[^\"'\\s]{6,160})(?P<suffix>[\"'])"
        }
      ]
    },
    "entropy": {
      "enabled": true,
      "min_length": 20,
      "max_length": 256,
      "min_bits_per_char": 4.0,
      "min_digit_ratio": 0.05,
      "max_digit_ratio": 0.6,
      "require_mixed_case": true,
      "require_digit": true,
      "alphabet": "A-Za-z0-9+/=_-",
      "max_letter_run_ratio": 0.5,
      "exempt_decodable_prose": true,
      "prose_min_printable_ratio": 0.95,
      "prose_min_space_ratio": 0.01
    },
    "known_values": {
      "enabled": true,
      "required": false,
      "min_length": 8,
      "sources": []
    }
  },
  "decoders": {
    "enabled": true,
    "max_depth": 2,
    "min_blob_length": 24,
    "max_blob_length": 65536,
    "min_printable_ratio": 0.9,
    "codecs": [
      "base64",
      "base64url",
      "hex"
    ],
    "one_decode_per_span": true,
    "max_blobs_per_target": 256
  },
  "whitelist": {
    "enabled": true,
    "value_classes": {
      "sha256": "^[0-9a-fA-F]{64}$",
      "git_commit": "^[0-9a-f]{7,40}$",
      "uuid": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "location_classes": {
      "test_fixture": {
        "path_globs": [
          "tests/**/fixtures/**",
          "**/fixtures/**",
          "tests/fixtures/**",
          "**/testdata/**"
        ],
        "inline_markers": [
          "secret-scan:allow"
        ]
      },
      "scanner_evidence": {
        "path_globs": [
          "artifacts/secret_scan/**"
        ],
        "inline_markers": [],
        "note": "the scanner's own masked evidence directory (previews + lengths + sha256 only)"
      }
    },
    "placeholder_regex": "<REDACTED:[^<>]{1,80}>"
  },
  "redaction": {
    "placeholder": "<REDACTED:{type}:{len}>",
    "max_type_chars": 32
  },
  "output": {
    "preview_prefix_chars": 2,
    "max_preview_chars": 12,
    "max_hits_per_target": 200,
    "hash_values": true
  },
  "exits": {
    "pre_commit": {
      "enabled": true,
      "staged_only": true,
      "max_file_bytes": 2097152
    },
    "report_gate": {
      "enabled": true,
      "apply_location_whitelist": false,
      "scan_decoded": true
    },
    "artifact_writer": {
      "enabled": true,
      "redact_on_hit": true,
      "verify_after_redact": true
    }
  },
  "profiles": {
    "full": {},
    "baseline": {
      "detectors.entropy.enabled": false,
      "detectors.known_values.enabled": false,
      "decoders.enabled": false,
      "whitelist.enabled": false
    }
  },
  "history": {
    "roots": [
      "/root/tp-agent/work"
    ],
    "mission_glob": "m*",
    "limit_missions": 200,
    "max_files_per_mission": 8,
    "max_total_files": 2400,
    "max_file_bytes": 1048576,
    "max_total_bytes": 50331648,
    "file_globs": [
      "report*.json",
      "docs/**/*.md",
      "artifacts/**/*.json",
      "artifacts/**/*.md",
      "artifacts/**/*.txt",
      "runs/**/*.json",
      "runs/**/*.jsonl"
    ],
    "exclude_globs": [
      "artifacts/secret_scan/**"
    ]
  },
  "neutrality": {
    "forbidden_terms": [
      "ship",
      "hull",
      "hydrodynamics",
      "cargo",
      "vessel",
      "propeller",
      "seakeeping",
      "kcs",
      "kvlcc2",
      "froude"
    ]
  }
}
