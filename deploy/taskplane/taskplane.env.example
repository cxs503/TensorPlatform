# 任务平面环境模板（PR-9 · AOG P1）——cp 为 taskplane.env 后填值。
# 凭据绝不入库：本文件只放键名与空值（CI 门 test_taskplane_infra 扫描）。

# --- 平台 API ---
TP_API_BASE=http://127.0.0.1:8010
TP_API=http://127.0.0.1:8010
TP_ORG_ID=
TP_API_USER=
TP_API_PASS=
TENSOR_API_BASE=
TENSOR_AGENT_USER=
TENSOR_AGENT_PASS=

# --- tp_worker 舰队（fleet_supervisor 逐席覆盖，此处为兜底默认）---
TP_ROLE=
TP_AGENT_ID=
TP_WORK_ROOT=

# --- PostgreSQL（guide_tracker/credit_ledger/wave_cycle/tp_pusher 经 psql）---
TP_PG_PASSWORD=

# --- 派单账号（merge_governor heal/eco_patrol；亦可挂 .eco_admin_creds.json）---
ECO_ADMIN_USER=eco_admin
ECO_ADMIN_PASS=

# --- LLM 网关（tp_worker 舰队经 fleet_supervisor 传递）---
OPENAI_BASE_URL=
LLM_MODEL=

# --- 宪章/待裁门控（1=拉起；全默认 0）---
AUTO_APPROVER_ON=0
ECO_PATROL_ON=0

# --- 停摆自检自愈 daemon（IN20-R5）：dry=只探活，live=真动作 ---
TP_STALL_ACTION_MODE=dry
TP_STALL_STARVE_SUSTAIN_S=900
TP_STALL_FLEET_LOSS_RATIO=0.5
TP_STALL_PULSE_STALL_S=1800
TP_STALL_COOLDOWN_S=1800

# --- 放门自动化 daemon（gate_auto_release.py；IN20-R2）---
GATE_ARTIFACT_ROOTS=
GATE_PG_HOST=
GATE_PG_USER=
GATE_PG_DB=
# psql 通道登录用（与 TP_PG_PASSWORD 同值即可；留空则只认 TP_PG_PASSWORD）
# 非敏感键留空 = 用脚本内默认（127.0.0.1 / foundation / tensorplatform）
PGPASSWORD=
TP_PG_HOST=
TP_PG_USER=
TP_PG_DB=
