{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tensorplatform/contracts/coupling/coupling-frames.v1.schema.json",
  "title": "Coordinate frame registry",
  "description": "跨求解器交换用的坐标系登记表。rotation 语义为 child -> parent (p_parent = R p_child + t), 必须是右手正交且 det=+1 的旋转。",
  "type": "object",
  "required": ["frames"],
  "additionalProperties": true,
  "properties": {
    "schema": {"type": "string"},
    "description": {"type": "string"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "handed": {"enum": ["right", "left"], "default": "right"},
          "z_up": {"type": "boolean", "default": true},
          "note": {"type": "string"}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["child", "parent"],
        "additionalProperties": true,
        "properties": {
          "child": {"type": "string"},
          "parent": {"type": "string"},
          "rotation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "array", "minItems": 3, "maxItems": 3,
                      "items": {"type": "number"}}
          },
          "translation": {
            "type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}
          }
        }
      }
    }
  }
}