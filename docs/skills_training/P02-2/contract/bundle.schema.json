{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "certification-bundle/1.0",
  "title": "Certification Export Bundle",
  "type": "object",
  "required": ["schema_version", "certification", "provenance", "export"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "certification": {
      "type": "object",
      "required": ["id", "subject", "standard", "verdict", "criteria", "evidence_refs", "issued_at", "signed_by"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": {
          "type": "object",
          "required": ["type", "name"],
          "properties": {
            "type": { "type": "string" },
            "name": { "type": "string" }
          }
        },
        "standard": { "type": "string" },
        "verdict": { "enum": ["PASS", "FAIL", "CONDITIONAL", "WITHHELD"] },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "result"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "result": { "enum": ["PASS", "FAIL", "NOT_EVIDENCE"] },
              "key_numbers": { "type": "object" }
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "sha256"],
            "properties": {
              "ref": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "issued_at": { "type": "string", "format": "date-time" },
        "signed_by": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["run_id", "git_commit", "platform_version"],
      "properties": {
        "run_id": { "type": "string" },
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "platform_version": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "required": ["job_id", "format", "exported_at", "generator"],
      "properties": {
        "job_id": { "type": "string" },
        "format": { "enum": ["json", "zip"] },
        "exported_at": { "type": "string", "format": "date-time" },
        "generator": { "type": "string" }
      }
    }
  }
}
