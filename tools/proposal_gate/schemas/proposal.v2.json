{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposal-gate/proposal.v2.json",
  "title": "proposal v2 — task-book 口径（规范内部模型的外部形态）",
  "description": "任务书口径提案契约。结构性约束在 schema，口径判据（repo 白名单、判据条数下限、每条判据可量化、is_maturity 必须为 bool）由 contract 层按 config/proposal_gate.json 执行，便于参数外置。",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "title", "repo", "goal", "is_maturity"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^2(\\.[0-9]+)*$"
    },
    "mission_id": {"type": ["integer", "null"], "minimum": 0},
    "plan_id": {"type": ["integer", "null"], "minimum": 0},
    "title": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "goal": {
      "type": "object",
      "required": ["objective", "criteria"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies_hint": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "is_maturity": {"type": "boolean"}
  }
}