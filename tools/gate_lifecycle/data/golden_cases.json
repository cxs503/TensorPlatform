    {"id": "g49", "tpl": "two_req", "m": {"err": 0.0500, "score": 0.95}, "expect_verdict": "PASS", "expect_status": "done"},
    {"id": "g50", "tpl": "two_req", "m": {"err": -0.01, "score": 0.99}, "expect_verdict": "PASS", "expect_status": "done"},
