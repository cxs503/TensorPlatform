{
  "schema": "gate-lifecycle-golden-verdict-corpus/v1",
  "label_source": "hand-authored expectations (stand-in for human adjudication); one label per case, written before the engine was run",
  "templates": {
    "le_err_5pct": [{"name": "err_le", "metric": "err", "op": "le", "threshold": 0.05, "required": true}],
    "le_err_tol": [{"name": "err_le_tol", "metric": "err", "op": "le", "threshold": 0.05, "tolerance": 0.001, "required": true}],
    "lt_strict": [{"name": "strict_lt", "metric": "err", "op": "lt", "threshold": 0.05, "required": true}],
    "ge_floor": [{"name": "floor_ge", "metric": "score", "op": "ge", "threshold": 0.95, "required": true}],
    "gt_pos": [{"name": "gain_gt", "metric": "gain", "op": "gt", "threshold": 0.0, "required": true}],
    "eq_tol": [{"name": "eq_tol", "metric": "value", "op": "eq", "threshold": 1.0, "tolerance": 1e-06, "required": true}],
    "abs_le": [{"name": "bal_abs_le", "metric": "balance", "op": "abs_le", "threshold": 0.05, "required": true}],
    "abs_lt": [{"name": "bal_abs_lt", "metric": "balance", "op": "abs_lt", "threshold": 0.05, "required": true}],
    "nested": [{"name": "nested_le", "metric": "a.b.c", "op": "le", "threshold": 0.05, "required": true}],
    "two_req": [
      {"name": "err_le", "metric": "err", "op": "le", "threshold": 0.05, "required": true},
      {"name": "score_ge", "metric": "score", "op": "ge", "threshold": 0.95, "required": true}
    ],
    "req_plus_opt": [
      {"name": "err_le", "metric": "err", "op": "le", "threshold": 0.05, "required": true},
      {"name": "drift_le", "metric": "drift", "op": "le", "threshold": 0.1, "required": false}
    ],
    "opt_only": [
      {"name": "drift_le", "metric": "drift", "op": "le", "threshold": 0.1, "required": false}
    ],
    "none": []
  },
  "cases": [
    {"id": "g01", "tpl": "le_err_5pct", "m": {"err": 0.01}, "expect_verdict": "PASS", "expect_status": "done"},
    {"id": "g02", "tpl": "le_err_5pct", "m": {"err": 0.04}, "expect_verdict": "PASS", "expect_status": "done"},
    {"id": "g03", "tpl": "le_err_5pct", "m": {"err": 0.0499}, "expect_verdict": "PASS", "expect_status": "done"},
    {"id": "g04", "tpl": "le_err_5pct", "m": {"err": 0.05}, "expect_verdict": "PASS", "expect_status": "done"},
    {"id": "g05", "tpl": "le_err_5pct", "m": {"err": 0.0501}, "expect_verdict": "FAIL", "expect_status": "failed"},
    {"id": "g06", "tpl": "le_err_5pct", "m": {"err": 0.2}, "expect_verdict": "FAIL", "expect_status": "failed"},
    {"id": "g07", "tpl": "le_err_5pct", "m": {}, "expect_verdict": "WITHHELD", "expect_status": "withheld"},
    {"id": "g08", "tpl": "le_err_5pct", "m": {"err": null}, "expect_verdict": "WITHHELD", "expect_status": "withheld"},
