{
  "suite": "fx_series",
  "version": 1,
  "description": "Synthetic geometric-series suite: partial sums vs closed-form limit, plus monotonicity of the partial-sum trajectory and of the tail error. Zero domain semantics.",
  "drift_threshold": 0.03,
  "cases": [
    {
      "id": "fx_series_r050_n20",
      "title": "Geometric partial sum r=0.5, 20 terms",
      "workload": "tools.benchmark_runner.synthetic:series_partial_sum",
      "inputs": {"ratio": 0.5, "terms": 20},
      "reference": {"workload": "tools.benchmark_runner.synthetic:series_reference",
                    "inputs": {"ratio": 0.5}},
      "criteria": [
        {"metric": "rel_error", "op": "<=", "value": 1e-5},
        {"metric": "trajectory", "op": "monotonic", "direction": "increasing"},
        {"metric": "tail_error", "op": "monotonic", "direction": "decreasing"}
      ],
      "tags": ["series", "monotonicity"]
    },
