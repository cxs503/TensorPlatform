{
  "suite": "pf_surfaces",
  "version": 1,
  "description": "existing platform verification surfaces executed unattended: accounting ETL numeric helpers, evidence-artifact hash chain, regression severity classifier (zero domain terms)",
  "drift_threshold": 0.03,
  "timeout_s": 60.0,
  "budget_s": 300.0,
  "cases": [
    {
      "id": "pf_kpi_hour_utc_min",
      "title": "existing surface: hour bucket (UTC, sub-minute truncation)",
      "workload": "tools.benchmark_runner.surfaces:kpi_hour_bucket",
      "inputs": {
        "ts_iso": "2026-11-10T05:37:12.345678+00:00"
      },
      "reference": {
        "workload": "tools.benchmark_runner.surfaces:ref_hour_bucket",
        "inputs": {
          "ts_iso": "2026-11-10T05:37:12.345678+00:00"
        }
      },
      "criteria": [
        {
          "metric": "rel_error",
          "op": "<=",
          "value": 1e-12
        }
      ]
    },
    {
      "id": "pf_kpi_hour_offset_west",
      "title": "existing surface: hour bucket (non-UTC offset)",
      "workload": "tools.benchmark_runner.surfaces:kpi_hour_bucket",
      "inputs": {
        "ts_iso": "2026-03-01T23:59:59-05:00"
      },
      "reference": {
        "workload": "tools.benchmark_runner.surfaces:ref_hour_bucket",
        "inputs": {
          "ts_iso": "2026-03-01T23:59:59-05:00"
        }
      },
      "criteria": [
        {
          "metric": "rel_error",
          "op": "<=",
          "value": 1e-12
        }
      ]
    },
    {
      "id": "pf_kpi_hour_epoch_zero",
      "title": "existing surface: hour bucket (epoch origin)",
      "workload": "tools.benchmark_runner.surfaces:kpi_hour_bucket",
      "inputs": {
        "ts_iso": "1970-01-01T00:00:00+00:00"
      },
      "reference": {
        "workload": "tools.benchmark_runner.surfaces:ref_hour_bucket",
        "inputs": {
          "ts_iso": "1970-01-01T00:00:00+00:00"
        }
      },
      "criteria": [
        {
          "metric": "rel_error",
          "op": "<=",
          "value": 1e-12
        }
      ]
    },
