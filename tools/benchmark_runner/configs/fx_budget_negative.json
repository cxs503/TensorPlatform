{
  "suite": "fx_budget_negative",
  "version": 1,
  "description": "NEGATIVE CONTROL (must FAIL). Proves the suite wall-clock budget is fail-closed: with a 1 s suite budget and a first case that consumes the whole budget, the second case must be recorded as error (failed_check '__budget__', never a silent skip, never a pass). A green run here means the budget guard is vacuous.",
  "drift_threshold": 0.03,
  "timeout_s": 5.0,
  "budget_s": 1.0,
  "cases": [
    {
      "id": "fx_budget_burner",
      "title": "consumes the entire suite budget (1 s) then gets cut off by its own timeout",
      "workload": "tools.benchmark_runner.synthetic:stall",
      "inputs": {
        "seconds": 20.0
      },
      "criteria": [
        {
          "metric": "value",
          "op": "<=",
          "value": 1.0
        }
      ],
      "tags": [
        "negative-control",
        "wall-clock"
      ]
    },
    {
      "id": "fx_budget_starved",
      "title": "must be recorded as error once the suite budget is exhausted (no silent skip)",
      "workload": "tools.benchmark_runner.synthetic:series_partial_sum",
      "inputs": {
        "ratio": 0.5,
        "terms": 12
      },
      "reference": {
        "workload": "tools.benchmark_runner.synthetic:series_reference",
        "inputs": {
          "ratio": 0.5
        }
      },
      "criteria": [
        {
          "metric": "rel_error",
          "op": "<=",
          "value": 1e-12
        }
      ]
    }
  ],
  "suite_criteria": [
    {
      "metric": "n_skipped_budget",
      "op": "<=",
      "value": 0
    },
    {
      "metric": "pass_ratio",
      "op": ">=",
      "value": 1.0
    }
  ]
}